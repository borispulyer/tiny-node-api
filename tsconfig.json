{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@config": ["./src/core/config"],
      "@config/*": ["./src/core/config/*"],
      "@utils": ["./src/core/utilities"],
      "@utils/*": ["./src/core/utilities/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "inlineSources": true,
    "allowUnreachableCode": true
  }
}
