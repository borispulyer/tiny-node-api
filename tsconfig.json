{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": { "@/*": ["./src/*"] },
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "inlineSources": true,
    "allowUnreachableCode": true
  }
}
