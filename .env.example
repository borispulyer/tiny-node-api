#	Example environment configuration

###
#	Server configuration
###
#	Port for the HTTP server
SERVER_PORT=3000
#	Absolute or relative path to static configuration files
SERVER_PATH_PUBLIC=./public
#	Absolute or relative path where filter functions are located
SERVER_PATH_FILTER=./filter
#	Enable the built-in heartbeat endpoint
SERVER_LOCATIONS_HEARTBEAT=true
#	Enable custom endpoints defined in ENDPOINTS
SERVER_LOCATIONS_ENDPOINTS=true
#	Enable direct filesystem access
SERVER_LOCATIONS_FILESYSTEM=true
#	Socket timeout in milliseconds
SERVER_TIMEOUTS_SOCKET=5000
#	Keep-alive timeout in milliseconds
SERVER_TIMEOUTS_KEEPALIVE=75000
#	Headers timeout in milliseconds
SERVER_TIMEOUTS_HEADERS=80000
#	Request timeout in milliseconds
SERVER_TIMEOUTS_REQUEST=60000
#	Maximum number of requests per socket
SERVER_MAX_REQUESTS=1000

###
#	Filesystem behaviour
###
#	Resolve file extensions automatically
FILESYSTEM_RESOLVE_EXT=true

###
#	Endpoint definitions
###
#	JSON array with sample endpoints:
#	1) Static path without filter
#	2) Static path with YAML input and JSON output
#	3) Parameterized path filter
#	4) Parameterized path with mutiple paramters and filter
ENDPOINTS='[
	{
		"enable":true,
		"path":"/api/v1/status",
		"file":"status.json"
	},{
		"enable":true,
		"path":"/api/v1/metrics",
		"file":"metrics.yaml",
		"format":"json",
	},{
		"enable":true,
		"path":"/api/v1/user/{id}",
		"file":"users.json"
		"filter":"./filter_user.js"
	},{
		"enable":true,
		"path":"/reports/{year}/{month}",
		"file":"reports.json",
		"filter":"./filter_reposrts.js"
	}
]'

###
#	Authentication
###
#	Enable OAuth2 authentication
AUTH_ENABLE=false
#	Realm presented to clients
AUTH_OAUTH2_REALM=Config API
#	OAuth2 issuer URI
AUTH_OAUTH2_ISSUER=https://issuer.example.com
#	JWKS endpoint providing public keys
AUTH_OAUTH2_JWKS=https://issuer.example.com/.well-known/jwks.json
#	Expected audience value
AUTH_OAUTH2_AUDIENCE=my-audience

###
#	Modifier modules
###
#	Enable modifier pipeline
MODIFIER_ENABLE=true
#	Enable modifier for merging files
MODIFIER_INCLUDE_ENABLE=true

###
#	Default formatter
###
#	Output format used when it is not specified (via file extensions e.g. http://example.com/file.json) or extension is not valid
FORMATTER_DEFAULT=json

###
#	HTTP request logging
###
#	Enable HTTP access logs
LOGGING_HTTP_ENABLE=true
#	Stream HTTP logs to stdout
LOGGING_HTTP_STDOUT_ENABLE=false
#	Log level for HTTP stdout logging
LOGGING_HTTP_STDOUT_LEVEL=info
#	Write HTTP logs to filesystem
LOGGING_HTTP_FILE_ENABLE=true
#	File path prefix for HTTP logs
LOGGING_HTTP_FILE=./logs/access
#	Log level for HTTP file logging
LOGGING_HTTP_FILE_LEVEL=info
#	Maximum size of each HTTP log before rotation
LOGGING_HTTP_LOGROTATION_SIZE=10M
#	How often HTTP logs rotate
LOGGING_HTTP_LOGROTATION_FREQUENCY=daily
#	Number of rotated HTTP logs to keep
LOGGING_HTTP_LOGROTATION_LIMIT=180
#	File extension for rotated HTTP logs
LOGGING_HTTP_LOGROTATION_EXTENSION=log
#	Date format in rotated HTTP log names
LOGGING_HTTP_LOGROTATION_DATEFORMAT=yyyy-MM-dd
#	Create symlink to latest HTTP log
LOGGING_HTTP_LOGROTATION_SYMLINK=false

###
#	Application logging
###
#	Enable application logs
LOGGING_APP_ENABLE=true
#	Stream application logs to stdout
LOGGING_APP_STDOUT_ENABLE=true
#	Log level for application stdout logging
LOGGING_APP_STDOUT_LEVEL=warn
#	Write application logs to filesystem
LOGGING_APP_FILE_ENABLE=true
#	File path prefix for application logs
LOGGING_APP_FILE=./logs/app
#	Log level for application file logging
LOGGING_APP_FILE_LEVEL=info
#	Maximum size of each application log before rotation
LOGGING_APP_LOGROTATION_SIZE=10M
#	How often application logs rotate
LOGGING_APP_LOGROTATION_FREQUENCY=daily
#	Number of rotated application logs to keep
LOGGING_APP_LOGROTATION_LIMIT=180
#	File extension for rotated application logs
LOGGING_APP_LOGROTATION_EXTENSION=log
#	Date format in rotated application log names
LOGGING_APP_LOGROTATION_DATEFORMAT=yyyy-MM-dd
#	Create symlink to latest application log
LOGGING_APP_LOGROTATION_SYMLINK=false