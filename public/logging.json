{
  "version": 1,
  "formatters": {
    "default": {
      "format": "%(asctime)s - %(levelname)s - %(name)s - %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "level": "DEBUG"
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "/var/log/app/app.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "formatter": "default",
      "level": "INFO"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "console",
      "file"
    ]
  }
}